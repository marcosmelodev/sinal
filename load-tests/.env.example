# Copie para load-tests/.env (ignorado pelo git) e ajuste. Não é lido pelo Spring, só pelo k6.
BASE_URL=http://localhost:8080
SINAL_EMAIL=carga.k6@exemplo.com
SINAL_SENHA=SenhaDeCarga123

# Perfil de carga (duração total precisa ficar abaixo dos 15 min de validade do token)
VUS_PICO=20
RAMP_UP=1m
PLATO=3m
RAMP_DOWN=1m
THINK_TIME_MAX=3

# Threshold de latência (p95, em ms). Com OpenAI real: 8000. Com mock lento + timeout PT3S: 4000.
P95_MS=8000
TIMEOUT_REQUISICAO=40s
